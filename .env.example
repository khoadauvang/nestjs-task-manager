# Copy to .env and adjust. The app refuses to start if a value is invalid.

NODE_ENV=development
PORT=3000
# Comma-separated list of front-end origins allowed by CORS (HTTP and WebSocket)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskmanager
DB_PASSWORD=taskmanager
DB_NAME=taskmanager
DB_LOGGING=false
# Apply pending migrations when the app starts
DB_RUN_MIGRATIONS=true

# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-48-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads
SWAGGER_ENABLED=true
